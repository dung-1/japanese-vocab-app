{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/**",
          "/*.(eot|svg|cur|jpg|png|webp|gif|otf|ttf|woff|woff2|ani)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "vocab-data",
      "urls": ["/assets/vocab-data/*.json"],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 5000000,
        "maxAge": "30d"
      }
    },
    {
      "name": "ai-data",
      "urls": [
        "/assets/kanji-words-data/*.json",
        "/assets/kanji-radicard-data/*.json",
        "/assets/reduplicative-words-data/*.json",
        "/assets/ai/*.json"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 5000000,
        "maxAge": "30d"
      }
    },
    {
      "name": "ai-chat",
      "urls": ["/api/chat"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 0,
        "maxAge": "1d"
      }
    },
    {
      "name": "pexels-images",
      "urls": ["https://images.pexels.com/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 10000000,
        "maxAge": "30d"
      }
    }
  ]
}